# Copy to .env. Vite reads these settings at startup; restart after editing.

# Development proxy target for /api, /openapi.json and /docs.
# Production reverse proxy configuration lives in Caddyfile.
JFE_API_PROXY=http://localhost:8090

# Caddy runtime upstream. Pass via docker run --env-file frontend/.env.
JFE_API_UPSTREAM=api:8090

# Public base path for development and production builds.
JFE_BASE_PATH=/

# Router mode (hash/history) is configured in public/config.json.
# Backend credentials and TMDB tokens belong in backend/.env, not here.
