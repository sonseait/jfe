# Copy to .env. API, scanner, downloader and transcoder read it from the working directory via Viper.
# Exported environment variables take precedence. Makefile targets also load this file.

DATABASE_URL=postgres://localhost:5432/jfe?sslmode=disable
JFE_LISTEN=:8090

# Log level: trace, debug, info, warn, error, fatal, panic, disabled.
# Log format: json (default) or console. Logs are written to stderr.
JFE_LOG_LEVEL=info
JFE_LOG_FORMAT=json

# Run binaries from backend/. Use the same paths for api, scanner, downloader and transcoder.
# Absolute paths are recommended when processes have different working directories.
JFE_MEDIA_ROOT=./media
JFE_CACHE_ROOT=./cache

# Dedicated writable YouTube storage. Empty disables importing.
JFE_IMPORT_ROOT=
# Python with Mutagen installed (requirements-audio.txt). Downloader also needs yt-dlp and Node on PATH.
JFE_PYTHON=python3

# Scanner job concurrency. Transcoding concurrency is configured in Administration.
JFE_CONCURRENCY=1

# Optional TMDB API Read Access Token. Local scanning works without it.
TMDB_TOKEN=

# Optional OpenSubtitles.com REST API credentials, configured on API and scanner.
# Some accounts require a bearer token for downloads; quotas are provider-managed.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_TOKEN=
# Optional VIP account login. Leave TOKEN empty to automatically renew logins.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Opt-in creation of new .vi.srt sidecars. Enable on API and scanner together,
# then enable individual movie/series libraries in Admin. Scanner needs writable
# video directories; API/transcoder must keep their video mounts read-only.
JFE_SUBTITLE_DOWNLOADS=false

# Opt-in original subtitle editing/deletion. Enable on API and scanner together.
# Scanner requires writable video directories; API/transcoder remain read-only.
JFE_SUBTITLE_EDITING=false

# Optional admin movie recommendations; API process only. Never sent to browsers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
